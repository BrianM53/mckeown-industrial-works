# McKeown Industrial Works: build and deployment settings.
#
# Everything here is optional and nothing is secret: the site needs no tokens, keys or paid APIs.
# BASE_PATH, SITE_URL and OUT_DIR are read from the *process environment* by vite.config.ts and
# scripts/prerender.tsx. Vite's .env loading only exposes VITE_* variables to client code, so set
# them in your shell or CI rather than relying on a .env file, e.g.
#   BASE_PATH=/mckeown-industrial-works/ SITE_URL=https://brianm53.github.io/mckeown-industrial-works/ npm run build

# Public base path the site is served from; must start and end with "/".
#   "/"                          domain root (Netlify, Vercel, custom domain, local preview)
#   "/mckeown-industrial-works/" GitHub Pages project site (set by .github/workflows/deploy.yml)
BASE_PATH=/

# Absolute public URL (with trailing slash) for canonical links, Open Graph/Twitter tags, the
# JSON-LD profile, sitemap.xml and robots.txt. Default: https://brianm53.github.io/mckeown-industrial-works/
# On Netlify and Vercel the host's production URL is used automatically when this is unset.
# Note: crawlers only read robots.txt at a domain root, so on a GitHub Pages project site submit
# SITE_URL/sitemap.xml in Search Console instead.
SITE_URL=https://brianm53.github.io/mckeown-industrial-works/

# Build output directory: "dist" for production, "dist-test" for the test-hook build (npm run build:test).
OUT_DIR=dist

# "true" keeps the window.__MIW__ debug/test hooks in a production build, for Playwright e2e runs only.
# `npm run build:test` sets it for you. Never enable it for a public deployment.
VITE_TEST_HOOKS=false

# Optional: commit id reported by /health.json. GitHub Actions, Netlify, Vercel and Cloudflare Pages
# commit SHAs are picked up automatically.
# COMMIT_SHA=

# Optional: a private Vite optimizer cache when several dev servers run side by side.
# VITE_CACHE_DIR=node_modules/.vite-local
