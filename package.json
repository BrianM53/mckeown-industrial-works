{
  "name": "mckeown-industrial-works",
  "private": true,
  "version": "1.0.0",
  "description": "McKeown Industrial Works — an explorable third-person 3D factory portfolio for Brian McKeown.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsx scripts/prerender.tsx",
    "build:test": "cross-env VITE_TEST_HOOKS=true OUT_DIR=dist-test vite build && cross-env OUT_DIR=dist-test tsx scripts/prerender.tsx",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:test": "vite preview --outDir dist-test --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build:test && npm run test:e2e",
    "shot": "node scripts/shot.mjs",
    "check:links": "tsx scripts/check-links.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
